{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sales-team.local/icp/schema.json",
  "title": "Austauschbares ICP-Profil v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "target", "discovery", "facts", "qualification", "signals", "grading", "exclusions", "enrichment"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/definitions/id"},
    "version": {"type": "string", "minLength": 1},
    "name": {"$ref": "#/definitions/text"},
    "description": {"$ref": "#/definitions/text"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "region", "companySize", "industries"],
      "properties": {
        "audience": {"$ref": "#/definitions/text"},
        "region": {
          "type": "object", "additionalProperties": false, "required": ["name", "countries"],
          "properties": {
            "name": {"$ref": "#/definitions/text"},
            "countries": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["code", "name", "defaultCity"],
              "properties": {
                "code": {"type": "string", "pattern": "^[A-Z]{2}$"},
                "name": {"$ref": "#/definitions/text"},
                "defaultCity": {"$ref": "#/definitions/text"}
              }
            }}
          }
        },
        "companySize": {
          "type": "object", "additionalProperties": false, "required": ["min", "max", "excludeBelow"],
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0},
            "excludeBelow": {"type": "integer", "minimum": 0}
          }
        },
        "industries": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "subcategories"],
          "properties": {
            "id": {"$ref": "#/definitions/id"},
            "name": {"$ref": "#/definitions/text"},
            "subcategories": {"$ref": "#/definitions/strings"}
          }
        }}
      }
    },
    "discovery": {
      "type": "object", "additionalProperties": false, "required": ["queries", "languageCode"],
      "properties": {
        "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
        "languageCode": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"}
      }
    },
    "facts": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/id"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["label", "type", "research"],
        "properties": {
          "label": {"$ref": "#/definitions/text"},
          "type": {"enum": ["string", "number", "boolean"]},
          "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/scalar"}},
          "research": {"$ref": "#/definitions/text"}
        }
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false, "required": ["maxEvidenceAgeDays", "allowedSourceTypes", "required"],
      "properties": {
        "maxEvidenceAgeDays": {"type": "integer", "minimum": 0},
        "allowedSourceTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["website", "registry", "job_board", "social", "news", "manual"]}},
        "required": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/criterion"}}
      }
    },
    "signals": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "priority", "when", "research"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "label": {"$ref": "#/definitions/text"},
        "priority": {"type": "integer", "minimum": 1},
        "when": {"$ref": "#/definitions/expression"},
        "research": {"$ref": "#/definitions/text"},
        "event": {
          "type": "object", "additionalProperties": false, "required": ["fact", "maxPastDays", "maxFutureDays"],
          "properties": {
            "fact": {"$ref": "#/definitions/id"},
            "maxPastDays": {"type": "integer", "minimum": 0},
            "maxFutureDays": {"type": "integer", "minimum": 0}
          }
        },
        "outreachHint": {"$ref": "#/definitions/text"}
      }
    }},
    "grading": {
      "type": "object", "additionalProperties": false, "required": ["rules", "fallback", "fallbackDescription"],
      "properties": {
        "rules": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["grade", "description", "requireAllMandatory", "signalIds", "minMatches", "datedOnly"],
          "properties": {
            "grade": {"enum": ["A", "B", "C"]},
            "description": {"$ref": "#/definitions/text"},
            "requireAllMandatory": {"type": "boolean"},
            "signalIds": {"$ref": "#/definitions/strings"},
            "minMatches": {"type": "integer", "minimum": 0},
            "datedOnly": {"type": "boolean"}
          }
        }},
        "fallback": {"enum": ["A", "B", "C"]},
        "fallbackDescription": {"$ref": "#/definitions/text"}
      }
    },
    "exclusions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "when", "effect", "onUnknown"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "label": {"$ref": "#/definitions/text"},
        "when": {"$ref": "#/definitions/expression"},
        "effect": {"enum": ["exclude", "flag"]},
        "onUnknown": {"enum": ["review", "ignore"]}
      }
    }},
    "enrichment": {
      "type": "object", "additionalProperties": false, "required": ["eligibleGrades", "tasks"],
      "properties": {
        "eligibleGrades": {"type": "array", "uniqueItems": true, "items": {"enum": ["A", "B", "C"]}},
        "tasks": {"$ref": "#/definitions/strings"}
      }
    },
    "outreach": {"type": "object", "additionalProperties": false, "required": ["hypothesis", "guidelines"], "properties": {
      "hypothesis": {"$ref": "#/definitions/text"}, "guidelines": {"$ref": "#/definitions/strings"}
    }}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/text"}},
    "scalar": {"type": ["string", "number", "boolean"]},
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "when"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "label": {"$ref": "#/definitions/text"}, "when": {"$ref": "#/definitions/expression"}
      }
    },
    "expression": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/expression"}}}},
      {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/expression"}}}},
      {"type": "object", "additionalProperties": false, "required": ["not"], "properties": {"not": {"$ref": "#/definitions/expression"}}},
      {
        "type": "object", "additionalProperties": false, "required": ["fact", "op"],
        "properties": {
          "fact": {"$ref": "#/definitions/id"},
          "op": {"enum": ["eq", "ne", "in", "gte", "lte", "lt", "gt"]},
          "value": {"oneOf": [{"$ref": "#/definitions/scalar"}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/scalar"}}]},
          "valueFrom": {"type": "string", "pattern": "^target\\.[A-Za-z][A-Za-z0-9.*]*$"}
        },
        "oneOf": [{"required": ["value"]}, {"required": ["valueFrom"]}]
      }
    ]}
  }
}
