# For your own instance only. npm start uses an isolated in-memory demo.
# Copy to .env.local; fill values locally, never commit credentials.
GOOGLE_PLACES_API_KEY=

APPWRITE_TRANSPORT=rest
APPWRITE_ENDPOINT=https://appwrite.example.invalid/v1
APPWRITE_PROJECT_ID=lead-research
APPWRITE_DATABASE_ID=lead-research
APPWRITE_API_KEY=
# Only set true for your own loopback/private Docker HTTP endpoint.
APPWRITE_TRUSTED_HTTP=false

BREVO_API_KEY=
OUTREACH_SENDER_EMAIL=
OUTREACH_SENDER_NAME=
OUTREACH_REPLY_TO_EMAIL=
OUTREACH_SEND_ENABLED=false
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASSWORD=
OUTREACH_IMAP_FOLDER=INBOX

# Required for production; separate random values, each at least 32 characters.
OUTREACH_API_TOKEN=
WEBSITE_QUIZ_BEARER_TOKEN=
OUTREACH_API_HOST=127.0.0.1
OUTREACH_API_ALLOWED_HOSTS=
OUTREACH_API_ALLOWED_ORIGINS=
