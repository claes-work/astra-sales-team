# The root `npm start` demo configures these values automatically.
# Local commands only bind to the loopback interface.
DASHBOARD_MODE=local
DASHBOARD_TEST_MODE=true
PORT=3210
SALES_API_PORT=8787
NEXT_TELEMETRY_DISABLED=1

# Optional: use a separately managed local API token instead of the default
# ../../.local/outreach/api-token.txt generated by the demo launcher.
# SALES_API_TOKEN_FILE=/absolute/path/to/local-api-token.txt

# Production: inject these variables into the standalone server/container.
# Use your own endpoints and IDs; example.invalid values are placeholders.
# DASHBOARD_MODE=production
# DASHBOARD_TEST_MODE=false
# DASHBOARD_ORIGIN=https://sales.example.invalid
# SALES_API_URL=http://sales-api:8787
# SALES_API_TOKEN_FILE=/run/secrets/sales_api_token
# APPWRITE_ENDPOINT=http://appwrite/v1
# APPWRITE_PROJECT_ID=lead-research
# APPWRITE_SSR_KEY_FILE=/run/secrets/appwrite_ssr_key
# DASHBOARD_ALLOWED_USER_IDS=your-appwrite-user-id
# PORT=3000
# HOSTNAME=0.0.0.0
